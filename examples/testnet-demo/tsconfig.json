      "@vindu/grid-core": ["../../packages/grid-core/src"],
      "@vindu/grid-stellar": ["../../packages/grid-stellar/src"],
      "@vindu/grid-blindpay": ["../../packages/grid-blindpay/src"]
    }
  },
  "include": ["src", "test"]
}
